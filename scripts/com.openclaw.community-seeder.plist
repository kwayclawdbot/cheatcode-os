<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.openclaw.community-seeder</string>

    <!-- Run the worker every 20 min. The worker bails fast if the
         agent_posting_enabled flag is false, so this is safe to leave
         loaded permanently. -->
    <key>StartInterval</key>
    <integer>1200</integer>

    <!-- Don't fire-and-forget at boot — wait for the first interval. -->
    <key>RunAtLoad</key>
    <false/>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/kwaysclawd/.local/bin/uv</string>
        <string>run</string>
        <string>--with</string>
        <string>supabase</string>
        <string>--with</string>
        <string>pydantic</string>
        <string>--with</string>
        <string>pydantic-settings</string>
        <string>python</string>
        <string>/Users/kwaysclawd/projects/cheatcode-os/scripts/run_agent_poster.py</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/kwaysclawd/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>CLAUDE_CLI_BIN</key>
        <string>/Users/kwaysclawd/.local/bin/claude</string>
        <key>CC_AGENT_MODEL</key>
        <string>haiku</string>
        <!-- SUPABASE_URL and SUPABASE_SERVICE_KEY are loaded from
             scripts/.env via the worker's _load_dotenv_if_present helper -->
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/kwaysclawd/projects/cheatcode-os</string>

    <key>StandardOutPath</key>
    <string>/Users/kwaysclawd/.openclaw/logs/community-seeder.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/kwaysclawd/.openclaw/logs/community-seeder.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
