{
  "buildCommand": "vite build",
  "outputDirectory": "dist/public",
  "framework": null,
  "installCommand": "pnpm install --no-frozen-lockfile",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://cheatcode-os-api-production.up.railway.app/api/v1/:path*"
    },
    {
      "source": "/api/trpc/:path*",
      "destination": "https://cheatcode-os-trpc-production.up.railway.app/api/trpc/:path*"
    },
    {
      "source": "/api/oauth/:path*",
      "destination": "https://cheatcode-os-trpc-production.up.railway.app/api/oauth/:path*"
    },
    {
      "source": "/api/upload",
      "destination": "https://cheatcode-os-trpc-production.up.railway.app/api/upload"
    },
    {
      "source": "/share/:ticker",
      "destination": "/api/share/:ticker"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
